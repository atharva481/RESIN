# ==========================================
# RESIN Research Assistant - .gitignore
# ==========================================

# Environment variables & secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Python Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
backend/.venv/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
*.manifest
*.spec

# Node.js & Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/
node_modules/.vite/
frontend/dist/
frontend/dist-ssr/
frontend/build/
.npm/
.eslintcache

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Code Editors
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# Temporary & Scratch Files
tmp/
temp/
scratch/
.cache/
