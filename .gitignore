# ==========================================
# RESIN Research Engine - .gitignore
# ==========================================

# Environment variables & secrets (Root, Backend, Frontend, Microservices)
.env
.env.*
*.env
*.env.*
*.local
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
frontend/.env.local
resin-triage/.env
resin-triage/.env.*

# Explicitly keep documented example templates tracked
!.env.example
!backend/.env.example
!frontend/.env.example
!resin-triage/.env.example

# Cryptographic keys, certificates & credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Python Virtual Environments
resin/
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
backend/.venv/
backend/venv/

# Python Cache, Bytecode & Profiling
__pycache__/
*/__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
*.manifest
*.spec

# Node.js & Dependencies
node_modules/
*/node_modules/
frontend/node_modules/
backend/node_modules/
resin-triage/node_modules/
node_modules/.vite/
.npm/
.eslintcache

# Frontend Builds & Static Bundles
frontend/dist/
frontend/dist-ssr/
frontend/build/
dist/
dist-ssr/
build/

# Uploads & User Content Cache
uploads/
backend/uploads/
temp_downloads/
pdf_cache/

# Logs & Debugging
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Databases & SQLite
*.sqlite
*.sqlite3
*.db

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Code Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# Temporary & Scratch Files
tmp/
temp/
scratch/
.cache/
