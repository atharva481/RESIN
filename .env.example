# ==========================================
# RESIN - Environment Configuration Overview
# ==========================================
# Copy the corresponding .env.example files in backend/, frontend/, and resin-triage/
# to their respective .env files before running the project.

# 1. Backend (backend/.env)
# -------------------------
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# VITE_SUPABASE_SERVICE_KEY=your_supabase_service_role_key
# VITE_GEMINI_API_KEY=AIzaSy...
# VITE_GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
# VITE_GEMINI_CHAT_MODEL=models/gemini-3.5-flash-lite
# REDIS_URL=redis://localhost:6379

# 2. Frontend (frontend/.env)
# --------------------------
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# VITE_RAG_BACKEND_URL=http://localhost:8000

# 3. Triage Microservice (resin-triage/.env)
# ------------------------------------------
# SUPABASE_DB_URL=postgresql://postgres.ref:password@host:5432/postgres
# GEMINI_API_KEY=AIzaSy...
# OPENALEX_EMAIL=your-email@example.com
